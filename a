        for (auto emp : employees) {
            auto it = std::find(allEmployees.begin(), allEmployees.end(), emp);
            if (it != allEmployees.end()) {
                delete emp;
                allEmployees.erase(it);
            }
        }
        delete dept;
        departments.erase(departments.begin() + deptIdx);
        std::cout << "Отдел удалён вместе со всеми сотрудниками\n";
    } else {
