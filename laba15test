// ========================== ЗАДАЧА 5.1 ==========================
class Gun {
private:
    int bullets;

public:
    Gun() : bullets(5) {}
    Gun(int b) : bullets(b) {}
    void shoot() {
        if (bullets > 0) {
            std::cout << "Бах!\n";
            bullets--;
        }
        else {
            std::cout << "Клац!\n";
        }
    }
    int getBullets() const { return bullets; }
    void reload(int b) {
        if (b >= 0) bullets = b;
        else std::cout << "Неверное количество патронов\n";
    }
    void print() const { std::cout << "Патронов: " << bullets << "\n"; }
};

